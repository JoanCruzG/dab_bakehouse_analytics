{
  "datasets": [
    {
      "name": "transactions_summary",
      "displayName": "Transactions Summary",
      "config": {
        "dimensions": [
          {
            "displayName": "Producto",
            "expr": "product",
            "name": "product"
          },
          {
            "displayName": "Método de pago",
            "expr": "paymentMethod",
            "name": "paymentMethod"
          }
        ],
        "measures": [
          {
            "displayName": "Cantidad total",
            "expr": "SUM(total_quantity)",
            "format": {
              "decimalPlaces": {
                "places": 0.0,
                "type": "exact"
              },
              "type": "number"
            },
            "name": "total_quantity"
          },
          {
            "displayName": "Ventas totales",
            "expr": "SUM(total_price)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 0.0,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "total_price"
          },
          {
            "displayName": "Precio promedio por unidad",
            "expr": "SUM(total_price) / NULLIF(SUM(total_quantity), 0)",
            "format": {
              "currencyCode": "USD",
              "decimalPlaces": {
                "places": 2.0,
                "type": "exact"
              },
              "type": "currency"
            },
            "name": "avg_price_per_unit"
          }
        ],
        "source": "bakehouse_analytics_dev.rnd.transactions_summary",
        "version": "1.1"
      }
    }
  ],
